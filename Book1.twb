      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID]) / TOTAL(COUNTD([Order ID]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Valid Orders' datatype='string' name='[Calculation_1271141038999425026]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Status] != &quot;Cancelled&quot; THEN [Order ID] END' />
      </column>
      <column caption='zero' datatype='integer' name='[Calculation_1271141039003271171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Total Sales Revenue' datatype='real' name='[Calculation_242631473845547008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Amount])' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_242631473845780481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID])' />
      </column>
      <column caption=' Average Order Value (AOV)' datatype='real' name='[Calculation_242631473845911554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Amount])/COUNTD([Order ID])' />
      </column>
      <column caption='Total Orders Shipped' datatype='integer' name='[Calculation_242631473859063813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Status] = &apos;Shipped&apos; OR [Status] = &apos;Shipped - Delivered to Buyer&apos; THEN 1 END)' />
      </column>
      <column caption='Cancelled Orders' datatype='integer' name='[Calculation_242631473863827462]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Status] = &apos;Cancelled&apos; THEN 1 END)' />
      </column>
      <column caption='Customer Repeat Rate' datatype='integer' name='[Calculation_275001096322408449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;  IF { FIXED : COUNT([Order ID]) &gt; 1 }&#13;&#10;  THEN [Order ID]&#13;&#10;  END&#13;&#10;)' />
      </column>
